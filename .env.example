# Copy to .env and replace every placeholder before running Docker Compose.
# .env is git-ignored. No real credential may ever be committed.

# --- PostgreSQL cluster (1 primary + 2 asynchronous replicas) ---
POSTGRES_IMAGE=postgres:16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser
PEDIDOS_DB=pedidos_db
INVENTARIO_DB=inventario_db
PEDIDOS_APP_USER=pedidos_app
PEDIDOS_APP_PASSWORD=change-me-pedidos-app
INVENTARIO_APP_USER=inventario_app
INVENTARIO_APP_PASSWORD=change-me-inventario-app
REPLICATOR_USER=replicator
REPLICATOR_PASSWORD=change-me-replicator

# --- Published ports (only these two reach the host) ---
EUREKA_PORT=8761
GATEWAY_PORT=8080

# --- Business service instances ---
PEDIDOS_1_INSTANCE_ID=pedidos-1
PEDIDOS_2_INSTANCE_ID=pedidos-2
INVENTARIO_1_INSTANCE_ID=inventario-1
INVENTARIO_2_INSTANCE_ID=inventario-2

# --- JVM sizing (Docker Desktop / WSL2 limits documented in README) ---
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70
