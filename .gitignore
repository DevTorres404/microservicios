# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# Secrets and local environment (only .env.example is versioned)
.env
.env.*
!.env.example
.pgpass*
*.key
*.pem
*.pfx
*.p12
*.cert
*.crt

# Maven build outputs and compiled classes
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
.flattened-pom.xml

# JVM crash logs and heap dumps
*.hprof
hs_err_pid*.log
replay_pid*.log

# General logs (except curated experimental evidence under docs/informes/raw/)
*.log
logs/
!docs/informes/raw/**

# IDEs and Editors
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.settings/
.project
.classpath
nbproject/private/
*.swp
*.swo
*~

# Operating System noise
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Local AI runtime and editor agent state
.atl/
.gemini/
.claude/
.cursor/

# Local Docker overrides
docker-compose.override.yml
*.pid

# Video presentation scripts and draft rehearsals
docs/guion*
